#!/usr/bin/env bash
set -euo pipefail
lane="${1:-}"
scope="${2:-}"
if [[ -z "$lane" || -z "$scope" ]]; then
  echo "Usage: $0 <lane-name> \"<feature scope>\"" >&2
  exit 1
fi
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
base="$(dirname "$root")"
wt="$base/$lane"
if [[ ! -d "$wt" ]]; then
  git -C "$root" worktree add "$wt" -b "$lane" main 2>/dev/null || git -C "$root" worktree add "$wt" "$lane"
fi
cd "$wt"
prompt="$lane: $scope. Work ONLY in this worktree ($wt). Own only this feature's files. Branch $lane. Done = smoke/tests green and commit ready for /review. Avoid files owned by other lanes in LANES.md."
exec claude --cloud "$prompt"
