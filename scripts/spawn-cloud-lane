#!/usr/bin/env bash
set -euo pipefail
lane="${1:-}"
scope="${2:-}"
if [[ -z "$lane" || -z "$scope" ]]; then
  echo "Usage: $0 <lane-name> \"<feature scope>\"" >&2
  exit 1
fi
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
base="$(dirname "$root")"
wt="$base/$lane"
if [[ ! -d "$wt" ]]; then
  git -C "$root" worktree add "$wt" -b "$lane" main 2>/dev/null || git -C "$root" worktree add "$wt" "$lane"
fi
cd "$wt"
prompt="$lane: $scope. Work ONLY in this worktree ($wt). Own only this feature's files per LANES.md. Branch $lane. Use Garry Tan gstack skills: implement carefully (/careful near risky edits), keep smoke/tests green, commit ready for local reviewer /review then /ship as its own PR. Never touch other lanes' files. Never use mcp__claude-in-chrome__*; use /browse."
exec claude --cloud "$prompt"
